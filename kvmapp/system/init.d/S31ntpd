#!/bin/sh
#
# ntpd        Starts BusyBox ntpd continuously.
#

PIDFILE="/run/ntpd.pid"

start() {
    if [ -r "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        return 0
    fi

    rm -f "$PIDFILE"

    printf "Starting ntpd: "
    /usr/bin/busybox ntpd -n \
        -p 0.pool.ntp.org \
        -p 1.pool.ntp.org \
        -p 2.pool.ntp.org \
        -p 3.pool.ntp.org \
        >/dev/null 2>&1 &
    pid="$!"
    echo "$pid" >"$PIDFILE"
    sleep 1
    if ! kill -0 "$pid" 2>/dev/null; then
        rm -f "$PIDFILE"
        echo "FAIL"
        return 1
    fi
    echo "OK"
}

stop() {
    printf "Stopping ntpd: "
    if [ -r "$PIDFILE" ]; then
        pid="$(cat "$PIDFILE")"
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null || true
        fi
        rm -f "$PIDFILE"
    fi
    echo "OK"
}

restart() {
    stop
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
